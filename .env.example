# Copy to .env for docker compose. Never commit real secrets.
POSTGRES_DB=ledgercore
POSTGRES_USER=ledgercore
POSTGRES_PASSWORD=change-me-locally
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# First-boot admin (created only if the email does not exist yet). Change the password after logging in.
BOOTSTRAP_ADMIN_EMAIL=admin@ledgercore.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-Admin-2026!
CORS_ORIGINS=http://localhost:3000
